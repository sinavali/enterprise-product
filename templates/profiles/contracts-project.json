{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "example-contracts",
  "projectType": "library",
  "sourceRoot": "libs/example-contracts/schemas",
  "tags": [
    "profile:d",
    "scope:shared",
    "lang:idl"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf lint && pnpm spectral lint schemas/openapi/**/*.yaml",
        "cwd": "libs/example-contracts"
      },
      "inputs": ["default"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf breaking --against 'https://github.com/my-org/monorepo.git#branch=main,subdir=libs/example-contracts' && pnpm oasdiff breaking origin/main schemas/openapi/openapi.yaml",
        "cwd": "libs/example-contracts"
      },
      "inputs": ["default"]
    },
    "generate-ts": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm openapi-typescript schemas/openapi/openapi.yaml -o src/generated/ts/api.d.ts",
        "cwd": "libs/example-contracts"
      },
      "outputs": ["{projectRoot}/src/generated/ts"]
    },
    "generate-dart": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm openapi-generator-cli generate -i schemas/openapi/openapi.yaml -g dart-dio -o src/generated/dart",
        "cwd": "libs/example-contracts"
      },
      "outputs": ["{projectRoot}/src/generated/dart"]
    },
    "generate-go": {
      "executor": "nx:run-commands",
      "options": {
        "command": "protoc --go_out=src/generated/go --go_opt=paths=source_relative schemas/proto/*.proto",
        "cwd": "libs/example-contracts"
      },
      "outputs": ["{projectRoot}/src/generated/go"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm tsc --build",
        "cwd": "libs/example-contracts"
      },
      "dependsOn": ["generate-ts"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm audit --audit-level high",
        "cwd": "libs/example-contracts"
      },
      "inputs": ["default"]
    }
  }
}
