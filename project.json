{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "enterprise-product",
  "projectType": "application",
  "sourceRoot": "scripts",
  "tags": [
    "profile:d",
    "scope:shared",
    "lang:python"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/ep.py verify"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m unittest discover tests"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/ep.py manifest sync"
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/ep.py audit"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/ep.py release pack"
      }
    }
  }
}
